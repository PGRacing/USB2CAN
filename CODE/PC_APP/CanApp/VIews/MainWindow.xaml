<Window x:Class="CanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CanApp"
        xmlns:converters="clr-namespace:CanApp.Converters"
        mc:Ignorable="d"
        Title="Can App" Height="450" Width="800">
    <Window.Resources>
        <converters:IntToHexConverter x:Key="IntToHexConverter"/>
    </Window.Resources>

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" AutoGenerateColumns="False" ItemsSource="{Binding Frames}" 
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID, Converter={StaticResource IntToHexConverter}}" />
                    <DataGridTextColumn Header="DLC" Binding="{Binding DLC}" />
                    <DataGridTextColumn Header="Data" Binding="{Binding DataDisplay}" />
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampString}" />
                </DataGrid.Columns>
            </DataGrid>

            

            <DataGrid Grid.Row="2" AutoGenerateColumns="False" 
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,30,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID, Converter={StaticResource IntToHexConverter}}" />
                    <DataGridTextColumn Header="DLC" Binding="{Binding DLC}" />
                    <DataGridTextColumn Header="Data" Binding="{Binding DataDisplay}" />
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource MyButtonStyle}" IsEnabled="{Binding IsStartEnabled}" Margin="0,0,10,0"/>
                <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource MyButtonStyle}" IsEnabled="{Binding IsStopEnabled}" Margin="0,0,10,0"/>
                <Button Content="Clear" Command="{Binding ClearFramesCommand}" Style="{StaticResource MyButtonStyle}" Margin="0,0,10,0"/>
            </StackPanel>

            
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" Width="80" Margin="0,0,0,10"/>
                <TextBox Text="{Binding MaxFrames, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,20,0,0"/>
                <Button Content="More..." Command="{Binding ShowDetailsCommand}" Style="{StaticResource MyButtonStyle}" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
