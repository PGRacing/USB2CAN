<Window x:Class="kolejna_proba.FramesByIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ramki według ID" Height="500" Width="600">
    <Window.Resources>
        <!-- Style dla przycisków -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style dla TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#888"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Style dla Label -->
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!-- Sekcja wyboru ID i przycisku -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Wybierz ID ramki:"/>
            <ComboBox x:Name="comboBoxFrameIds" Width="100" Margin="5,0,0,0" SelectionChanged="comboBoxFrameIds_SelectionChanged"/>
            <Button Content="Pokaż wykres" Click="ShowChartButton_Click" Width="100" Margin="10,0,0,0"/>
        </StackPanel>
        <!-- Tabela z ramkami o wybranym ID -->
        <DataGrid x:Name="dataGridFramesById" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sequence ID" Binding="{Binding SequenceId}" Width="100"/>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeFormatted}" Width="150"/>
                <DataGridTextColumn Header="Data" Binding="{Binding DataString}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
